# Hermes Agent Remote VPS Gateway (dijangkau via host.docker.internal).
# Di VPS: Hermes jalan di host yang sama, jadi langsung konek.
# Di lokal (Windows): jalankan container tunnel dengan `docker compose --profile local up -d`.
# Port 8642 TIDAK perlu dibuka ke publik.
HERMES_API_URL=http://host.docker.internal:8642/v1
HERMES_API_KEY=your_secure_hermes_key_here
HERMES_TIMEOUT_MS=180000
HERMES_SSH_HOST=your.vps.ip.here
HERMES_SSH_USER=ubuntu
